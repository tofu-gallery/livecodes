+
+// Tofu copy: these features need a GitHub login (upstream's Firebase project) or
+// upstream's broadcast server, neither of which a copy can use, so their entry points go.
+const tofuRemovedActions = ['Export to GitHub Gist', 'Deploy', 'Broadcast', 'Sync', 'Sponsor'];
+
+const withoutTofuRemovedActions = (list: any[]): any[] =>
+  list
+    .filter((action) => !tofuRemovedActions.includes(action?.id))
+    .map((action) =>
+      Array.isArray(action?.children)
+        ? { ...action, children: withoutTofuRemovedActions(action.children) }
+        : action,
+    );
+
+const removeTofuFeatures = () => {
+  ['#login-link', '#logout-link', '#broadcast-status-btn'].forEach((selector) =>
+    document.querySelector(selector)?.remove(),
+  );
+  ['#export-githubGist', '#deploy-link', '#broadcast-link', '#sync-link'].forEach((selector) =>
+    document.querySelector(selector)?.closest('li')?.remove(),
+  );
+  // also closes ?screen=login|deploy|sync|broadcast
+  ['login', 'deploy', 'sync', 'broadcast'].forEach((name) => {
+    const index = screens.findIndex((s) => s.screen === name);
+    if (index !== -1) screens.splice(index, 1);
+  });
 };
 
